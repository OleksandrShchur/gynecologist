{
  "name": "oksana-perhulyn",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "images": "node scripts/optimize-images.mjs",
    "predev": "npm run images",
    "dev": "vite --host 127.0.0.1",
    "check": "npm run images && tsc --noEmit",
    "prebuild": "npm run images",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run build && npm run test:types && playwright test",
    "test:types": "tsc --project tsconfig.test.json --noEmit",
    "test:report": "playwright show-report",
    "qa": "node scripts/qa.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.0.0",
    "@fontsource/manrope": "^5.0.0",
    "@react-three/fiber": "^8.18.0",
    "@shadergradient/react": "^2.4.20",
    "camera-controls": "^3.1.2",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "lighthouse": "^12.8.2",
    "postcss": "^8.5.6",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
